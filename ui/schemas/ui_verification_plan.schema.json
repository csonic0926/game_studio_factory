{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Verification Plan",
  "description": "Three layers, never merged (3.4): mechanical checks covering every event and preview; blind chains listing the MUST_KNOW facts the observer's own fields must show understood, with readability hypotheses; USER playtest signals. Every MUST_KNOW fact is verified by a blind chain or a USER signal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mechanical_checks",
    "blind_chains",
    "user_playtest_signals"
  ],
  "properties": {
    "schema_version": {
      "const": "ui_verification_plan.v1"
    },
    "mechanical_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "kind",
          "covers",
          "method"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "method": {
            "description": "the test or command that runs it on a build",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blind_chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "must_know_fact_ids",
          "hypotheses"
        ],
        "properties": {
          "chain_id": {
            "type": "string",
            "minLength": 1
          },
          "must_know_fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "statement",
                "falsifier",
                "fallback"
              ],
              "properties": {
                "hypothesis_id": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "falsifier": {
                  "type": "string",
                  "minLength": 1
                },
                "fallback": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "user_playtest_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_id",
          "question",
          "fact_ids"
        ],
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
