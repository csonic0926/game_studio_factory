{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Attention and Motion Plan",
  "description": "What draws the eye, when and for how long (3.2). Every transient-cue fact has an event; waiting cues are bounded by max_wait_ms <= max_latency_ms; every contract beat names its first focus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protected_elements",
    "events",
    "beats"
  ],
  "properties": {
    "schema_version": {
      "const": "ui_attention_plan.v1"
    },
    "protected_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id",
          "description"
        ],
        "properties": {
          "element_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "source",
          "fact_ids",
          "cue",
          "max_latency_ms",
          "min_readable_ms",
          "clock",
          "skip_behavior",
          "max_concurrent_per_object",
          "priority",
          "on_collision",
          "never_covers"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cue": {
            "type": "string",
            "minLength": 1
          },
          "max_latency_ms": {
            "type": "integer",
            "minimum": 1
          },
          "min_readable_ms": {
            "type": "integer",
            "minimum": 1
          },
          "clock": {
            "enum": [
              "REAL_TIME",
              "GAME_SPEED"
            ]
          },
          "skip_behavior": {
            "type": "string",
            "minLength": 1
          },
          "max_concurrent_per_object": {
            "type": "integer",
            "minimum": 1
          },
          "priority": {
            "type": "integer"
          },
          "on_collision": {
            "enum": [
              "REPLACE",
              "WAIT",
              "MERGE",
              "DROP",
              "STACK"
            ]
          },
          "never_covers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_wait_ms": {
            "description": "WAIT/MERGE only; at most max_latency_ms",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat_id",
          "first_focus",
          "calm_until"
        ],
        "properties": {
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "first_focus": {
            "type": "string",
            "minLength": 1
          },
          "calm_until": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
