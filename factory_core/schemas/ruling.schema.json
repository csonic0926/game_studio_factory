{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "factory_ruling.v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "factory_ruling.v2"
    },
    "owner": {
      "const": "USER"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "game",
            "factory"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "scope",
        "path",
        "sha256"
      ]
    },
    "dependency_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "game",
            "factory"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "scope",
        "path",
        "sha256"
      ]
    },
    "quote": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "owner",
    "decision",
    "design",
    "dependency_fingerprint",
    "source",
    "quote"
  ]
}
