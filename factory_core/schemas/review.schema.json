{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "factory_review.v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "factory_review.v2"
    },
    "role": {
      "enum": [
        "intent_experience",
        "completeness_project"
      ]
    },
    "reviewer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "fresh": {
      "const": true
    },
    "peer_reviews_read": {
      "type": "array",
      "maxItems": 0
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "game",
            "factory"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "scope",
        "path",
        "sha256"
      ]
    },
    "dependency_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "findings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "enum": [
                        "game",
                        "factory"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "scope",
                    "path",
                    "sha256"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "const": "game_git"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40,64}$"
                    }
                  },
                  "required": [
                    "scope",
                    "path",
                    "sha256",
                    "revision"
                  ]
                }
              ]
            },
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "evidence",
          "rationale"
        ]
      }
    },
    "source_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "role",
    "reviewer_context_id",
    "fresh",
    "peer_reviews_read",
    "design",
    "dependency_fingerprint",
    "verdict",
    "findings",
    "source_coverage",
    "decision_coverage"
  ]
}
