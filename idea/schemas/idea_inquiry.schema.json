{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idea_inquiry.v1",
  "description": "Substantive per-idea inquiry (idea/docs/PRODUCT_DEFINITION_WORKFLOW.md#every-idea-receives-substantive-inquiry). Validated by idea/inquiry.py; it records reasoning, it does not prove fun.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic",
    "ideas",
    "coupling",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "idea_inquiry.v1"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "coupling": {
      "type": "string",
      "minLength": 1,
      "description": "How these ideas consume or feed each other and the rest of the game."
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "idea",
          "authority",
          "player_situation",
          "mechanism",
          "cost_or_tension",
          "alternatives",
          "evidence",
          "assumptions",
          "judgment",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "idea": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "USER",
              "SOURCE",
              "AI_HYPOTHESIS"
            ]
          },
          "player_situation": {
            "type": "string",
            "minLength": 1,
            "description": "Why the player would care or choose."
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "description": "How the mechanism produces its consequence."
          },
          "cost_or_tension": {
            "type": "string",
            "minLength": 1,
            "description": "The real cost, sacrificed possibility or tension it creates."
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "judgment": {
            "enum": [
              "ADOPT",
              "REJECT",
              "OPEN"
            ]
          },
          "reasons": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "idea_ids",
              "disposition"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "idea_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "disposition": {
                "const": "OPEN"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "idea_ids",
              "disposition",
              "answer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "idea_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "disposition": {
                "const": "ANSWERED"
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "idea_ids",
              "disposition",
              "falsification",
              "test_stage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "idea_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "disposition": {
                "const": "HYPOTHESIS"
              },
              "falsification": {
                "type": "string",
                "minLength": 1
              },
              "test_stage": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "idea_ids",
              "disposition",
              "reason",
              "revisit"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "idea_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "disposition": {
                "const": "DEFERRED"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "revisit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
