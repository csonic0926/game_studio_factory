{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-ai-factory.local/gameplay/gameplay_decision_card.schema.json",
  "title": "Human Gameplay Decision Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "project_id",
    "objective_id",
    "factory_revision",
    "routing",
    "product_authority",
    "studio_gameplay_system",
    "player_facing_interaction_contract",
    "player_facing_interaction_contract_review",
    "author_context_id",
    "player_promise",
    "core_cycle",
    "material_commitments",
    "red_lines",
    "validation_hypotheses",
    "decision_payload_sha256",
    "human_verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "gameplay_decision_card.v2"
    },
    "card_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "objective_id": {
      "$ref": "#/$defs/id"
    },
    "factory_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "routing": {
      "enum": [
        "STUDIO_WHOLE_GAME",
        "DIRECT_SPECIALIST"
      ]
    },
    "product_authority": {
      "$ref": "#/$defs/optional_path_hash"
    },
    "studio_gameplay_system": {
      "$ref": "#/$defs/optional_path_hash"
    },
    "author_context_id": {
      "$ref": "#/$defs/id"
    },
    "player_promise": {
      "$ref": "#/$defs/promise"
    },
    "core_cycle": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cycle_step"
      }
    },
    "material_commitments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "red_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "validation_hypotheses": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "decision_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "human_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_text",
        "recorded_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "USER_APPROVED",
            "USER_DELEGATED",
            "USER_REJECTED"
          ]
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "player_facing_interaction_contract": {
      "$ref": "#/$defs/path_hash"
    },
    "player_facing_interaction_contract_review": {
      "$ref": "#/$defs/path_hash"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "optional_path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        }
      }
    },
    "promise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "cycle_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "falsification_signal",
        "status"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "falsification_signal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "const": "TESTABLE_DESIGN"
        }
      }
    },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
