{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-ai-factory.local/gameplay/gameplay_factory_init_result.schema.json",
  "title": "Gameplay Factory Initialization Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project_id",
    "source_revision",
    "source_dirty_paths",
    "source_working_tree_sha256",
    "initial_objective_input_path",
    "artifact_sha256",
    "warnings",
    "handoff"
  ],
  "properties": {
    "schema_version": {"const": "gameplay_factory_init_result.v1"},
    "status": {"const": "GAMEPLAY_FACTORY_READY"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "source_revision": {"type": "string", "minLength": 1},
    "source_dirty_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_working_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "initial_objective_input_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "handoff": {"type": "string", "minLength": 1}
  }
}
