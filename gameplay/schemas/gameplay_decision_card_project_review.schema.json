{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-ai-factory.local/gameplay/gameplay_decision_card_project_review.schema.json",
  "title": "Project-Specific Gameplay Decision Card Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "review_role",
    "project_id",
    "objective_id",
    "factory_revision",
    "project_card_authoring_standard",
    "project_composition_artifacts",
    "player_facing_interaction_contract",
    "player_facing_interaction_contract_review",
    "decision_card",
    "author_context_ids",
    "reviewer_context_id",
    "reviewer_freshness",
    "requirement_findings",
    "render_only_findings",
    "blocking_findings",
    "verdict",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "gameplay_decision_card_project_review.v1"},
    "review_id": {"$ref": "#/$defs/id"},
    "review_role": {"const": "PROJECT_CARD_AUTHORING_STANDARD_REVIEW"},
    "project_id": {"$ref": "#/$defs/id"},
    "objective_id": {"$ref": "#/$defs/id"},
    "factory_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "project_card_authoring_standard": {"$ref": "#/$defs/versioned_path_hash"},
    "project_composition_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/composition_ref"}
    },
    "player_facing_interaction_contract": {"$ref": "#/$defs/path_hash"},
    "player_facing_interaction_contract_review": {"$ref": "#/$defs/path_hash"},
    "decision_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "decision_payload_sha256", "rendered_surface_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "decision_payload_sha256": {"$ref": "#/$defs/sha256"},
        "rendered_surface_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "author_context_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_artifact_authors",
        "interaction_contract_author",
        "decision_card_author"
      ],
      "properties": {
        "composition_artifact_authors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "interaction_contract_author": {"$ref": "#/$defs/id"},
        "decision_card_author": {"$ref": "#/$defs/id"}
      }
    },
    "reviewer_context_id": {"$ref": "#/$defs/id"},
    "reviewer_freshness": {"const": "FRESH"},
    "requirement_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "applicability", "verdict", "evidence_refs", "rationale"],
        "properties": {
          "requirement_id": {"$ref": "#/$defs/id"},
          "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
          "verdict": {"enum": ["PASS", "NOT_APPLICABLE", "BLOCK"]},
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["surface", "ref"],
              "properties": {
                "surface": {"enum": ["CARD_CLAIM", "COMPOSITION_ARTIFACT", "INTERACTION_CONTRACT"]},
                "ref": {"type": "string", "minLength": 1}
              }
            }
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "render_only_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "evidence_claim_ids", "verdict", "rationale"],
        "properties": {
          "requirement_id": {"$ref": "#/$defs/id"},
          "evidence_claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "verdict": {"enum": ["PASS", "BLOCK"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verdict": {
      "enum": [
        "PASS_PROJECT_CARD_AUTHORING_STANDARD",
        "REVISE_PROJECT_CARD_BEFORE_FACTORY"
      ]
    },
    "reviewed_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {"const": "PASS_PROJECT_CARD_AUTHORING_STANDARD"}
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "blocking_findings": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "blocking_findings": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "versioned_path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "composition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind_id", "path", "sha256", "author_context_id"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "kind_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "author_context_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
