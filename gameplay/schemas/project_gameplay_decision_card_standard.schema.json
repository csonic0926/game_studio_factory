{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-ai-factory.local/gameplay/project_gameplay_decision_card_standard.schema.json",
  "title": "Project Gameplay Decision Card Authoring Standard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard_id",
    "project_id",
    "version",
    "status",
    "applicable_routings",
    "adoption",
    "collaboration_contract",
    "vocabulary",
    "repeatable_lap",
    "player_work_boundary",
    "granularity_rules",
    "interaction_requirements",
    "resolution_boundaries",
    "failure_recovery_replay",
    "validation_methods",
    "independence_rules",
    "synchronization_rules",
    "composition_artifact_kinds",
    "requirements",
    "render_only_requirement_ids"
  ],
  "properties": {
    "schema_version": {"const": "project_gameplay_decision_card_standard.v1"},
    "standard_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT_NOT_ADOPTED", "ACTIVE", "STALE"]},
    "applicable_routings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["STUDIO_WHOLE_GAME", "DIRECT_SPECIALIST"]}
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "authority_ref", "adopted_at"],
      "properties": {
        "status": {"enum": ["NOT_ADOPTED", "HUMAN_OR_PROJECT_AUTHORITY_ADOPTED"]},
        "owner": {"type": "string", "minLength": 1},
        "authority_ref": {"type": "string", "minLength": 1},
        "adopted_at": {"type": "string", "minLength": 1}
      }
    },
    "collaboration_contract": {"$ref": "#/$defs/path_hash"},
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term_id", "term", "definition"],
        "properties": {
          "term_id": {"$ref": "#/$defs/id"},
          "term": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1}
        }
      }
    },
    "repeatable_lap": {"$ref": "#/$defs/nonempty_strings"},
    "player_work_boundary": {"$ref": "#/$defs/nonempty_strings"},
    "granularity_rules": {"$ref": "#/$defs/nonempty_strings"},
    "interaction_requirements": {"$ref": "#/$defs/nonempty_strings"},
    "resolution_boundaries": {"$ref": "#/$defs/nonempty_strings"},
    "failure_recovery_replay": {"$ref": "#/$defs/nonempty_strings"},
    "validation_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method_id", "use", "observable_evidence", "falsification_rule"],
        "properties": {
          "method_id": {"$ref": "#/$defs/id"},
          "use": {"type": "string", "minLength": 1},
          "observable_evidence": {"type": "string", "minLength": 1},
          "falsification_rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "independence_rules": {"$ref": "#/$defs/nonempty_strings"},
    "synchronization_rules": {"$ref": "#/$defs/nonempty_strings"},
    "composition_artifact_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind_id", "name", "purpose", "required"],
        "properties": {
          "kind_id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "rule", "applicability", "evidence_surface"],
        "properties": {
          "requirement_id": {"$ref": "#/$defs/id"},
          "rule": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "evidence_surface": {
            "enum": ["CARD", "COMPOSITION", "INTERACTION_CONTRACT", "MULTIPLE"]
          }
        }
      }
    },
    "render_only_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
