{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-ai-factory.local/gameplay/gameplay_design_verdict.schema.json",
  "title": "Gameplay Objective Design Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "verdict_id", "project_id", "objective_id",
    "factory_revision", "objective_gameplay", "context_status", "decision_card",
    "conformance_reviews", "factory_verdict", "blocking_findings", "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "gameplay_design_verdict.v2"},
    "verdict_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "objective_id": {"$ref": "#/$defs/id"},
    "factory_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "objective_gameplay": {"$ref": "#/$defs/path_hash"},
    "context_status": {"enum": ["READY_FOR_HOW_DESIGN", "READY_FOR_NEW_GAMEPLAY_DESIGN"]},
    "decision_card": {"$ref": "#/$defs/path_hash"},
    "conformance_reviews": {
      "type": "object", "additionalProperties": false,
      "required": ["card_to_spec", "spec_to_card"],
      "properties": {
        "card_to_spec": {"$ref": "#/$defs/path_hash"},
        "spec_to_card": {"$ref": "#/$defs/path_hash"}
      }
    },
    "factory_verdict": {"const": "PASS_DESIGN_CONFORMANCE"},
    "blocking_findings": {"type": "array", "maxItems": 0},
    "reviewed_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "path_hash": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
