{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-ai-factory.local/gameplay/gameplay_new_project_bootstrap_probe.schema.json",
  "title": "Gameplay New-Project Bootstrap Probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "objective_id",
    "factory_revision",
    "repository",
    "authorities",
    "decision_payload_sha256",
    "system_projection",
    "interpretation_warning"
  ],
  "properties": {
    "schema_version": {"const": "gameplay_new_project_bootstrap_probe.v1"},
    "project_id": {"$ref": "#/$defs/id"},
    "objective_id": {"$ref": "#/$defs/id"},
    "factory_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision_payload_sha256": {"$ref": "#/$defs/sha256"},
    "interpretation_warning": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_revision", "source_paths", "source_tree_sha256"],
      "properties": {
        "expected_revision": {
          "oneOf": [
            {"const": "UNBORN_HEAD"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "source_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_register",
        "product_authority",
        "studio_gameplay_system",
        "studio_gameplay_definition",
        "decision_card",
        "decision_register",
        "final_card_review"
      ],
      "properties": {
        "product_register": {"$ref": "#/$defs/ref"},
        "product_authority": {"$ref": "#/$defs/ref"},
        "studio_gameplay_system": {"$ref": "#/$defs/ref"},
        "studio_gameplay_definition": {"$ref": "#/$defs/ref"},
        "decision_card": {"$ref": "#/$defs/ref"},
        "decision_register": {"$ref": "#/$defs/ref"},
        "final_card_review": {"$ref": "#/$defs/ref"}
      }
    },
    "system_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "cycle_id",
        "system_promise",
        "core_player_verbs",
        "feedback_state_ids",
        "card_claims"
      ],
      "properties": {
        "system_id": {"$ref": "#/$defs/id"},
        "cycle_id": {"$ref": "#/$defs/id"},
        "system_promise": {"type": "string", "minLength": 1},
        "core_player_verbs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "feedback_state_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "card_claims": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
