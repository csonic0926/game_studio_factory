{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-ai-factory.local/gameplay/production_plan_manifest.schema.json",
  "title": "Production Plan Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "objective_id",
    "objective_gameplay_path",
    "objective_gameplay_sha256",
    "planning_status",
    "plans",
    "row_coverage",
    "blocked_gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "production_plan_manifest.v2"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_gameplay_path": {
      "type": "string",
      "minLength": 1
    },
    "objective_gameplay_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "planning_status": {
      "enum": [
        "READY_FOR_EXECUTION",
        "BLOCKED_BY_PLAN_GAP"
      ]
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "row_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "blocked_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "path",
        "title",
        "status",
        "objective_rows",
        "depends_on",
        "work_types",
        "existing_repo_refs",
        "planned_paths",
        "ui_impact"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "READY_FOR_EXECUTION",
            "BLOCKED_BY_PLAN_GAP"
          ]
        },
        "objective_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "work_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONTENT_DATA",
              "CODE",
              "UI",
              "ASSET",
              "AUDIO",
              "LOCALIZATION",
              "TEST",
              "OBSERVABILITY"
            ]
          }
        },
        "existing_repo_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "planned_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ui_impact": {
          "$ref": "#/$defs/ui_impact"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_row",
        "disposition",
        "plan_ids",
        "rationale"
      ],
      "properties": {
        "objective_row": {
          "type": "integer",
          "minimum": 1
        },
        "disposition": {
          "enum": [
            "IMPLEMENT",
            "VERIFY_EXISTING",
            "NO_CHANGE_REQUIRED"
          ]
        },
        "plan_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ui_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "touches_ui",
        "adapter_path",
        "adapter_sha256",
        "rule_ids",
        "exemplar_ids",
        "validation_scenario_ids"
      ],
      "properties": {
        "touches_ui": {
          "type": "boolean"
        },
        "adapter_path": {
          "type": "string"
        },
        "adapter_sha256": {
          "type": "string"
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exemplar_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_scenario_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "touches_ui": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "adapter_path": {
                "const": "design/gameplay/adapter/UI_PRODUCTION_ADAPTER.json"
              },
              "adapter_sha256": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "rule_ids": {
                "minItems": 1
              },
              "exemplar_ids": {
                "minItems": 1
              },
              "validation_scenario_ids": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "adapter_path": {
                "const": ""
              },
              "adapter_sha256": {
                "const": ""
              },
              "rule_ids": {
                "maxItems": 0
              },
              "exemplar_ids": {
                "maxItems": 0
              },
              "validation_scenario_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
