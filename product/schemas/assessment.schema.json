                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "enum": [
                        "game",
                        "factory"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "scope",
                    "path",
                    "sha256"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "const": "game_git"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
