{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_judgment_case.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "enum": [
                        "game",
                        "factory"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "scope",
                    "path",
                    "sha256"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "const": "game_git"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40,64}$"
                    }
                  },
                  "required": [
                    "scope",
                    "path",
                    "sha256",
                    "revision"
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "build"
      ]
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "CURRENT_OFFER",
            "ADOPTED_OFFER",
            "PROPOSED_OFFER",
            "SCENARIO",
            "UNKNOWN"
          ]
        },
        "grounding": {
          "enum": [
            "GROUNDED",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "enum": [
                      "game",
                      "factory"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "const": "game_git"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256",
                  "revision"
                ]
              }
            ]
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "adoption": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "scope": {
                          "enum": [
                            "game",
                            "factory"
                          ]
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "scope",
                        "path",
                        "sha256"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "scope": {
                          "const": "game_git"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "revision": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40,64}$"
                        }
                      },
                      "required": [
                        "scope",
                        "path",
                        "sha256",
                        "revision"
                      ]
                    }
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "quote"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "grounding",
        "amount",
        "currency",
        "platform",
        "region",
        "as_of",
        "provenance",
        "rationale",
        "adoption"
      ]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grounding": {
          "enum": [
            "GROUNDED",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "enum": [
                      "game",
                      "factory"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "const": "game_git"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256",
                  "revision"
                ]
              }
            ]
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "grounding",
        "description",
        "provenance",
        "rationale"
      ]
    },
    "schema_version": {
      "const": "product_judgment_case.v1"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "retrospective",
        "prospective_new_observation"
      ]
    },
    "exposure_note": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "enum": [
                  "game",
                  "factory"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "scope",
              "path",
              "sha256"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "const": "game_git"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              }
            },
            "required": [
              "scope",
              "path",
              "sha256",
              "revision"
            ]
          }
        ]
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "enum": [
                      "game",
                      "factory"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "const": "game_git"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256",
                  "revision"
                ]
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "source",
          "quote"
        ]
      }
    }
  },
  "required": [
    "assessment_id",
    "subject",
    "offer",
    "audience",
    "schema_version",
    "question",
    "mode",
    "exposure_note",
    "sources",
    "conditions"
  ]
}
