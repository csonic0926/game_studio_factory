{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_value_intent.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "product_value_intent.v1"
    },
    "state": {
      "enum": [
        "OPEN",
        "DRAFTED"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "const": "game"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "scope",
          "path",
          "sha256"
        ]
      },
      "uniqueItems": true
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "CURRENT_OFFER",
            "ADOPTED_OFFER",
            "PROPOSED_OFFER",
            "SCENARIO",
            "UNKNOWN"
          ]
        },
        "grounding": {
          "enum": [
            "GROUNDED",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "const": "game"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "const": "game_git"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256",
                  "revision"
                ]
              }
            ]
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "adoption": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "scope": {
                          "const": "game"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "scope",
                        "path",
                        "sha256"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "scope": {
                          "const": "game_git"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "revision": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40,64}$"
                        }
                      },
                      "required": [
                        "scope",
                        "path",
                        "sha256",
                        "revision"
                      ]
                    }
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "quote"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "grounding",
        "amount",
        "currency",
        "platform",
        "region",
        "as_of",
        "provenance",
        "rationale",
        "adoption"
      ]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grounding": {
          "enum": [
            "GROUNDED",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "const": "game"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "const": "game_git"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40,64}$"
                  }
                },
                "required": [
                  "scope",
                  "path",
                  "sha256",
                  "revision"
                ]
              }
            ]
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "grounding",
        "description",
        "provenance",
        "rationale"
      ]
    },
    "buying_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "adequacy_case": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "value_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "const": "game"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "scope",
                    "path",
                    "sha256"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "const": "game_git"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40,64}$"
                    }
                  },
                  "required": [
                    "scope",
                    "path",
                    "sha256",
                    "revision"
                  ]
                }
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "source_refs"
        ]
      }
    },
    "material_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_move": {
      "type": "string",
      "minLength": 1
    },
    "current_build_assessment": {
      "const": "NOT_ASSESSED"
    },
    "value_claim_eligible": {
      "const": false
    },
    "authority_granted": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "state",
    "source_refs",
    "offer",
    "audience",
    "buying_reason",
    "adequacy_case",
    "value_hypotheses",
    "material_unknowns",
    "next_move",
    "current_build_assessment",
    "value_claim_eligible",
    "authority_granted"
  ]
}
