{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/player_facing_runtime_interaction_evidence.schema.json",
  "title": "Player-Facing Runtime Interaction Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "project_id",
    "unit_id",
    "game_revision",
    "build_id",
    "factory_revision",
    "interaction_contract",
    "producer_context_id",
    "clean_start",
    "scenario_entry_state",
    "capture_environment",
    "ordered_input_trace",
    "structural_evidence",
    "observable_changes",
    "returned_surface",
    "localization_observation",
    "evidence_files",
    "captured_at"
  ],
  "properties": {
    "schema_version": {
      "const": "player_facing_runtime_interaction_evidence.v1"
    },
    "evidence_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "unit_id": {
      "$ref": "#/$defs/id"
    },
    "game_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "build_id": {
      "$ref": "#/$defs/id"
    },
    "factory_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "interaction_contract": {
      "$ref": "#/$defs/path_hash"
    },
    "producer_context_id": {
      "$ref": "#/$defs/id"
    },
    "clean_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "save_identity",
        "save_state",
        "start_state"
      ],
      "properties": {
        "save_identity": {
          "$ref": "#/$defs/text"
        },
        "save_state": {
          "const": "CLEAN_START"
        },
        "start_state": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "scenario_entry_state": {
      "$ref": "#/$defs/text"
    },
    "capture_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "window_mode",
        "rendering_mode"
      ],
      "properties": {
        "engine": {
          "$ref": "#/$defs/text"
        },
        "window_mode": {
          "const": "WINDOWED"
        },
        "rendering_mode": {
          "const": "IN_ENGINE"
        }
      }
    },
    "ordered_input_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trace"
      }
    },
    "structural_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "CAPTURED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "observable_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat_id",
          "before",
          "after",
          "response_channels"
        ],
        "properties": {
          "beat_id": {
            "$ref": "#/$defs/id"
          },
          "before": {
            "$ref": "#/$defs/text"
          },
          "after": {
            "$ref": "#/$defs/text"
          },
          "response_channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/visible_channel"
            }
          }
        }
      }
    },
    "returned_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "visible_next_affordance",
        "discovery_channels"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/path_hash"
        },
        "visible_next_affordance": {
          "$ref": "#/$defs/text"
        },
        "discovery_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/visible_channel"
          }
        }
      }
    },
    "localization_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "status",
        "fallback_used",
        "garbled_text_present",
        "evidence"
      ],
      "properties": {
        "locale": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "const": "OBSERVED_READABLE"
        },
        "fallback_used": {
          "const": false
        },
        "garbled_text_present": {
          "const": false
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "evidence_files": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "captured_at": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "TBD"
      }
    },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact"
      ],
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/text"
        },
        "artifact": {
          "$ref": "#/$defs/path_hash"
        }
      }
    },
    "visible_channel": {
      "enum": [
        "WORLD_OBJECT",
        "CHARACTER",
        "CAMERA",
        "ANIMATION",
        "AUDIO",
        "WORLD_GEOMETRY",
        "CONTROL_STATE"
      ]
    },
    "input_kind": {
      "enum": [
        "MOVEMENT",
        "POSITIONING",
        "AIM",
        "TIMING",
        "SELECTION",
        "MANIPULATION",
        "RESOURCE_COMMITMENT",
        "COMBAT_COMMAND",
        "NAVIGATION",
        "CONTEXT_ACTION",
        "DIALOGUE_CHOICE"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "beat_id",
        "input_kind",
        "control",
        "player_intent",
        "frame_before",
        "frame_during",
        "frame_after",
        "observed_response"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "beat_id": {
          "$ref": "#/$defs/id"
        },
        "input_kind": {
          "$ref": "#/$defs/input_kind"
        },
        "control": {
          "$ref": "#/$defs/text"
        },
        "player_intent": {
          "$ref": "#/$defs/text"
        },
        "frame_before": {
          "$ref": "#/$defs/path_hash"
        },
        "frame_during": {
          "$ref": "#/$defs/path_hash"
        },
        "frame_after": {
          "$ref": "#/$defs/path_hash"
        },
        "observed_response": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
