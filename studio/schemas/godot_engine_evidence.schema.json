{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/godot_engine_evidence.schema.json",
  "title": "Godot Engine Operation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_version",
    "operation_id",
    "operation_type",
    "status",
    "factory_revision",
    "started_at",
    "finished_at",
    "duration_ms",
    "project",
    "engine",
    "capability_manifest",
    "invocation",
    "result",
    "artifacts",
    "acceptance_authority",
    "gameplay_verdict",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "godot_engine_evidence.v1"},
    "adapter_version": {"const": "godot_cli_adapter.v1"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "operation_type": {
      "enum": ["IMPORT_CHECK", "RUN_PROJECT", "RUN_SCENE", "EXPORT_DEBUG", "EXPORT_RELEASE"]
    },
    "status": {"enum": ["PASS", "FAIL", "TIMEOUT"]},
    "factory_revision": {"$ref": "#/$defs/revision"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_dir",
        "project_file_before",
        "project_file_after",
        "source_repository_before",
        "source_repository_after",
        "source_mutated"
      ],
      "properties": {
        "project_dir": {"type": "string", "minLength": 1},
        "project_file_before": {"$ref": "#/$defs/file_observation"},
        "project_file_after": {"$ref": "#/$defs/file_observation"},
        "source_repository_before": {"$ref": "#/$defs/repository_binding"},
        "source_repository_after": {"$ref": "#/$defs/repository_binding"},
        "source_mutated": {"type": "boolean"}
      }
    },
    "engine": {"$ref": "#/$defs/engine"},
    "capability_manifest": {"$ref": "#/$defs/path_hash"},
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "working_directory", "timeout_seconds", "headless"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "working_directory": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "headless": {"type": "boolean"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "timed_out", "termination", "detected_errors", "assertions"],
      "properties": {
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "termination": {"enum": ["NONE", "TERMINATE", "KILL"]},
        "detected_errors": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1}
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion", "expected", "passed"],
            "properties": {
              "assertion": {"const": "OUTPUT_CONTAINS"},
              "expected": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "acceptance_authority": {"const": "EVIDENCE_ONLY"},
    "gameplay_verdict": {"const": "NOT_ISSUED"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"exists": {"const": true}}},
          "then": {"properties": {"sha256": {"pattern": "^[0-9a-f]{64}$"}}},
          "else": {"properties": {"sha256": {"const": ""}}}
        }
      ]
    },
    "repository_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty_paths", "working_tree_sha256"],
      "properties": {
        "revision": {"$ref": "#/$defs/revision"},
        "dirty_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "working_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_kind", "command_name", "version", "version_parts"],
      "properties": {
        "locator_kind": {"enum": ["EXPLICIT", "ENV", "PATH", "MACOS_APPLICATION"]},
        "command_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "version_parts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major", "minor", "patch"],
          "properties": {
            "major": {"type": "integer", "minimum": 4},
            "minor": {"type": "integer", "minimum": 0},
            "patch": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {
          "enum": ["STDOUT_LOG", "STDERR_LOG", "GODOT_ENGINE_LOG", "EXPORTED_BUILD"]
        },
        "kind": {"enum": ["FILE", "DIRECTORY"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
