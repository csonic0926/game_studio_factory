{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/godot_automation_evidence.schema.json",
  "title": "Godot Automation Immutable Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_version", "operation_id", "operation_type", "status", "factory_revision", "started_at", "finished_at", "project", "engine", "automation_manifest", "invocation", "result", "assertions", "replay", "artifacts", "project_gameplay_evidence_refs", "acceptance_authority", "gameplay_verdict", "limitations"],
  "properties": {
    "schema_version": {"const": "godot_automation_evidence.v1"},
    "adapter_version": {"const": "godot_automation.v1"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "operation_type": {"enum": ["DOCTOR", "BRIDGE_INSTALL", "BRIDGE_UPGRADE", "BRIDGE_REMOVE", "SCENARIO_RUN", "SCENARIO_REPLAY", "LIVE_SESSION", "VISUAL_COMPARE", "BUILD_RUN", "RECOVERED_OPERATION"]},
    "status": {"enum": ["PASS", "FAIL", "TIMEOUT", "BLOCKED", "ABORTED"]},
    "factory_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_dir", "source_repository_before", "source_repository_after", "source_mutated", "source_mutation_allowed"],
      "properties": {"project_dir": {"type": "string", "minLength": 1}, "source_repository_before": {"$ref": "#/$defs/repository"}, "source_repository_after": {"$ref": "#/$defs/repository"}, "source_mutated": {"type": "boolean"}, "source_mutation_allowed": {"type": "boolean"}}
    },
    "engine": {"oneOf": [{"$ref": "#/$defs/engine"}, {"type": "null"}]},
    "automation_manifest": {"type": "object"},
    "invocation": {"type": "object"},
    "result": {"type": "object"},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "replay": {"oneOf": [{"$ref": "#/$defs/replay"}, {"type": "null"}]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "project_gameplay_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/path_hash"}},
    "acceptance_authority": {"const": "EVIDENCE_ONLY"},
    "gameplay_verdict": {"const": "NOT_ISSUED"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_hash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "repository": {"type": "object", "additionalProperties": false, "required": ["revision", "dirty_paths", "working_tree_sha256"], "properties": {"revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}, "dirty_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "working_tree_sha256": {"$ref": "#/$defs/sha"}}},
    "engine": {"type": "object", "additionalProperties": false, "required": ["locator_kind", "command_name", "version", "version_parts"], "properties": {"locator_kind": {"enum": ["EXPLICIT", "ENV", "PATH", "MACOS_APPLICATION"]}, "command_name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "version_parts": {"type": "object", "additionalProperties": false, "required": ["major", "minor", "patch"], "properties": {"major": {"type": "integer", "minimum": 4}, "minor": {"type": "integer", "minimum": 0}, "patch": {"type": "integer", "minimum": 0}}}}},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["assertion_id", "status", "expected", "actual", "detail"], "properties": {"assertion_id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "expected": {}, "actual": {}, "detail": {"type": "string"}}},
    "replay": {"type": "object", "additionalProperties": false, "required": ["status", "reference_trace_sha256", "actual_trace_sha256", "first_divergence"], "properties": {"status": {"enum": ["MATCH", "DIVERGED", "INCONCLUSIVE"]}, "reference_trace_sha256": {"$ref": "#/$defs/sha"}, "actual_trace_sha256": {"$ref": "#/$defs/sha"}, "first_divergence": {"type": ["integer", "null"], "minimum": 0}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["role", "kind", "path", "sha256", "size_bytes"], "properties": {"role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "kind": {"enum": ["FILE", "DIRECTORY"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "size_bytes": {"type": "integer", "minimum": 0}}}
  }
}
