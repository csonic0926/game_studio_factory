{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/baseline_regression_review.schema.json",
  "title": "Accepted Baseline Regression Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "project_id", "game_revision", "build_id", "reviewer_context_id", "reviewer_freshness", "predecessor_baseline", "covered_unit_ids", "commands", "result_paths", "status", "blocking_findings", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "baseline_regression_review.v1"},
    "review_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "game_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "build_id": {"$ref": "#/$defs/id"},
    "reviewer_context_id": {"$ref": "#/$defs/id"},
    "reviewer_freshness": {"const": "FRESH"},
    "predecessor_baseline": {"$ref": "#/$defs/path_hash"},
    "covered_unit_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path_hash"}},
    "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "blocking_findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviewed_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "path_hash": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"blocking_findings": {"maxItems": 0}}}}
  ]
}
