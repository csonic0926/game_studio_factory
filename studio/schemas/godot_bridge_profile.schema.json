{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/godot_bridge_profile.schema.json",
  "title": "Godot Runtime Bridge Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "provider_autoload", "allowed_input_actions", "allowed_keycodes", "allowed_mouse_buttons", "project_commands", "observations", "checkpoints", "structural_nodes"],
  "properties": {
    "schema_version": {"const": "godot_bridge_profile.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "provider_autoload": {"type": "string", "minLength": 1},
    "allowed_input_actions": {"$ref": "#/$defs/unique_strings"},
    "allowed_keycodes": {"$ref": "#/$defs/unique_nonnegative_integers"},
    "allowed_mouse_buttons": {"$ref": "#/$defs/unique_nonnegative_integers"},
    "project_commands": {"$ref": "#/$defs/unique_strings"},
    "observations": {"$ref": "#/$defs/unique_strings"},
    "checkpoints": {"$ref": "#/$defs/unique_strings"},
    "structural_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "node_path", "facts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "node_path": {"type": "string", "pattern": "^/"},
          "facts": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["class", "visible", "focus", "position", "size", "global_position", "theme", "styleboxes", "text", "disabled"]}
          }
        }
      }
    }
  },
  "$defs": {
    "unique_strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unique_nonnegative_integers": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
  }
}
