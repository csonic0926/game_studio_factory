{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/baseline_admission_result.schema.json",
  "title": "Baseline Admission Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "admission_id", "admission_mode", "project_id", "game_revision", "input", "predecessor_baseline", "accepted_baseline", "promoted_unit_ids", "handoff"],
  "properties": {
    "schema_version": {"const": "baseline_admission_result.v1"},
    "status": {"const": "BASELINE_ADMITTED"},
    "admission_id": {"$ref": "#/$defs/id"},
    "admission_mode": {"enum": ["RECONSTRUCT", "PROMOTE"]},
    "project_id": {"$ref": "#/$defs/id"},
    "game_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "input": {"$ref": "#/$defs/path_hash"},
    "predecessor_baseline": {"$ref": "#/$defs/optional_path_hash"},
    "accepted_baseline": {"$ref": "#/$defs/path_hash"},
    "promoted_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "handoff": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "path_hash": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "optional_path_hash": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}}
    }
  }
}
