{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/godot_engine_capability_manifest.schema.json",
  "title": "Godot Engine Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_version",
    "status",
    "factory_revision",
    "generated_at",
    "project",
    "engine",
    "capabilities",
    "blockers",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "godot_engine_capability_manifest.v1"},
    "adapter_version": {"const": "godot_cli_adapter.v1"},
    "status": {"enum": ["READY", "BLOCKED"]},
    "factory_revision": {"$ref": "#/$defs/revision"},
    "generated_at": {"type": "string", "format": "date-time"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir", "project_file", "source_repository"],
      "properties": {
        "project_dir": {"type": "string", "minLength": 1},
        "project_file": {"$ref": "#/$defs/path_hash"},
        "source_repository": {"$ref": "#/$defs/repository_binding"}
      }
    },
    "engine": {"$ref": "#/$defs/engine"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "status", "evidence_kind", "detail"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "status": {
            "enum": [
              "AVAILABLE",
              "PARTIAL",
              "PROJECT_CONFIGURATION_REQUIRED",
              "NOT_IMPLEMENTED",
              "UNAVAILABLE"
            ]
          },
          "evidence_kind": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repository_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty_paths", "working_tree_sha256"],
      "properties": {
        "revision": {"$ref": "#/$defs/revision"},
        "dirty_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "working_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_kind", "command_name", "version", "version_parts"],
      "properties": {
        "locator_kind": {"enum": ["EXPLICIT", "ENV", "PATH", "MACOS_APPLICATION"]},
        "command_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "version_parts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major", "minor", "patch"],
          "properties": {
            "major": {"type": "integer", "minimum": 4},
            "minor": {"type": "integer", "minimum": 0},
            "patch": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
