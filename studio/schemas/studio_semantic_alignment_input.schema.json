{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/studio_semantic_alignment_input.schema.json",
  "title": "Studio Semantic Alignment Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interaction_id", "project_id", "factory_revision", "trigger", "author_context_id", "user_input", "active_authorities", "pending_decisions", "input_deltas", "proposed_transition", "candidate_output", "output_claims", "human_questions", "authored_at"],
  "properties": {
    "schema_version": {"const": "studio_semantic_alignment_input.v2"},
    "interaction_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "factory_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "trigger": {"enum": ["MATERIAL_USER_INPUT", "REVISED_AUTHORITY", "HUMAN_DECISION_SURFACE", "BLOCKING_HUMAN_QUESTION"]},
    "author_context_id": {"$ref": "#/$defs/id"},
    "user_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sha256"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "active_authorities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_id", "authority_kind", "artifact"],
        "properties": {
          "authority_id": {"$ref": "#/$defs/id"},
          "authority_kind": {"enum": ["PRODUCT", "STUDIO_GAMEPLAY_SYSTEM", "GAMEPLAY_DECISION_CARD", "ACCEPTED_BASELINE", "REPO_EVIDENCE", "REFERENCE_EVIDENCE"]},
          "artifact": {"$ref": "#/$defs/path_hash"}
        }
      }
    },
    "pending_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_payload_sha256", "decision_card", "disposition"],
        "properties": {
          "decision_payload_sha256": {"$ref": "#/$defs/sha256"},
          "decision_card": {"$ref": "#/$defs/path_hash"},
          "disposition": {"enum": ["PRESERVE_PENDING", "SUPERSEDE_PENDING", "WITHDRAW_BY_PRODUCT_ARCHIVE"]}
        }
      }
    },
    "input_deltas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["delta_id", "source_quote", "classification", "target_authority_ids", "interpretation"],
        "properties": {
          "delta_id": {"$ref": "#/$defs/id"},
          "source_quote": {"type": "string", "minLength": 1},
          "classification": {"enum": ["ADD", "MODIFY", "REVOKE", "AMBIGUOUS"]},
          "target_authority_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "interpretation": {"type": "string", "minLength": 1}
        }
      }
    },
    "proposed_transition": {"enum": ["CONTINUE_EXISTING_AUTHORITY", "REOPEN_PRODUCT_EXPLORATION", "REVISE_STUDIO_GAMEPLAY_SYSTEM", "REVISE_DECISION_CARD", "REQUEST_HUMAN_RULING", "NO_MATERIAL_CHANGE", "ARCHIVE_PRODUCT_DIRECTION"]},
    "candidate_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "sha256"],
      "properties": {
        "kind": {"enum": ["DECISION_SURFACE", "HUMAN_QUESTION", "MATERIAL_RESPONSE"]},
        "text": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "output_quote", "provenance", "source_authority_ids", "source_quotes"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/id"},
          "output_quote": {"type": "string", "minLength": 1},
          "provenance": {"enum": ["PRESERVED_AUTHORITY", "NEW_USER_INPUT", "REPO_EVIDENCE", "REFERENCE_EVIDENCE", "AI_SYNTHESIS", "AI_HYPOTHESIS"]},
          "source_authority_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "source_quotes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "human_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "question_quote", "material_consequence", "searched_authority_ids", "why_unresolved"],
        "properties": {
          "question_id": {"$ref": "#/$defs/id"},
          "question_quote": {"type": "string", "minLength": 1},
          "material_consequence": {"type": "string", "minLength": 1},
          "searched_authority_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "why_unresolved": {"type": "string", "minLength": 1}
        }
      }
    },
    "authored_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
