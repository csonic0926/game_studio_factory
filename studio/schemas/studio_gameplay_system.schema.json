{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio-factory.local/studio/studio_gameplay_system.schema.json",
  "title": "Studio Core Gameplay System",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "system_id", "cycle_id", "project_id",
    "factory_revision", "product_authority", "product_input", "factory_constraints",
    "author_context_id", "system_promise", "core_player_verbs", "stages",
    "state_objects", "transitions", "cycle_path", "feedback_state_ids",
    "coupled_systems", "causal_link_coverage", "constraint_coverage", "non_goal_coverage",
    "two_lap_witness", "forbidden_linearizations", "authored_at"
  ],
  "properties": {
    "schema_version": {"const": "studio_gameplay_system.v2"},
    "status": {"const": "STUDIO_GAMEPLAY_SYSTEM_READY"},
    "system_id": {"$ref": "#/$defs/id"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "factory_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "product_authority": {"$ref": "#/$defs/path_hash"},
    "product_input": {"$ref": "#/$defs/path_hash"},
    "factory_constraints": {"$ref": "#/$defs/path_hash"},
    "author_context_id": {"$ref": "#/$defs/id"},
    "system_promise": {"type": "string", "minLength": 1, "maxLength": 160, "not": {"pattern": "TBD"}},
    "core_player_verbs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "stages": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/stage"}},
    "state_objects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/state"}},
    "transitions": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/transition"}},
    "cycle_path": {"type": "array", "minItems": 6, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "feedback_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "coupled_systems": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/coupled_system"}},
    "causal_link_coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/link_coverage"}},
    "constraint_coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/constraint_coverage"}},
    "non_goal_coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/non_goal_coverage"}},
    "two_lap_witness": {"$ref": "#/$defs/two_lap"},
    "forbidden_linearizations": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 180, "not": {"pattern": "TBD"}}},
    "authored_at": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1, "not": {"pattern": "TBD"}},
    "path_hash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["stage_id", "player_goal"], "properties": {"stage_id": {"$ref": "#/$defs/id"}, "player_goal": {"$ref": "#/$defs/text"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["state_id", "kind", "owner", "player_visible", "meaning"], "properties": {"state_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["RESOURCE", "PROGRESSION", "SOCIAL", "CONTENT", "COMMITMENT", "EXTERNAL", "RECORD", "CAPABILITY"]}, "owner": {"$ref": "#/$defs/text"}, "player_visible": {"type": "boolean"}, "meaning": {"$ref": "#/$defs/text"}}},
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "from_stage_id", "to_stage_id", "phase", "player_action", "reads_state_ids", "writes_state_ids", "visible_consequence", "motivation_effect", "causal_link_ids", "constraint_ids"],
      "properties": {
        "transition_id": {"$ref": "#/$defs/id"}, "from_stage_id": {"$ref": "#/$defs/id"}, "to_stage_id": {"$ref": "#/$defs/id"},
        "phase": {"enum": ["PLAYER_GOAL", "READ", "PLAYER_DECISION", "COMMITMENT", "PRESENTATION", "RESOLUTION", "REWARD", "REINVESTMENT", "RETURN"]},
        "player_action": {"$ref": "#/$defs/text"}, "reads_state_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "writes_state_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "visible_consequence": {"$ref": "#/$defs/text"}, "motivation_effect": {"$ref": "#/$defs/text"},
        "causal_link_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "constraint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "coupled_system": {"type": "object", "additionalProperties": false, "required": ["component_id", "role", "transition_ids", "required_in_first_baseline"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "role": {"type": "string", "minLength": 1, "maxLength": 180, "not": {"pattern": "TBD"}}, "transition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "required_in_first_baseline": {"const": true}}},
    "link_coverage": {"type": "object", "additionalProperties": false, "required": ["link_id", "transition_ids", "status"], "properties": {"link_id": {"$ref": "#/$defs/id"}, "transition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "status": {"const": "REALIZED_IN_CYCLE"}}},
    "constraint_coverage": {"type": "object", "additionalProperties": false, "required": ["constraint_id", "transition_ids", "status"], "properties": {"constraint_id": {"$ref": "#/$defs/id"}, "transition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "status": {"const": "REALIZED_IN_CYCLE"}}},
    "non_goal_coverage": {"type": "object", "additionalProperties": false, "required": ["non_goal_id", "transition_ids", "status", "rationale"], "properties": {"non_goal_id": {"$ref": "#/$defs/id"}, "transition_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "status": {"const": "PRESERVED"}, "rationale": {"$ref": "#/$defs/text"}}},
    "lap": {"type": "object", "additionalProperties": false, "required": ["player_goal", "decision", "resolution", "resulting_state"], "properties": {"player_goal": {"$ref": "#/$defs/text"}, "decision": {"$ref": "#/$defs/text"}, "resolution": {"$ref": "#/$defs/text"}, "resulting_state": {"$ref": "#/$defs/text"}}},
    "delta": {"type": "object", "additionalProperties": false, "required": ["state_id", "before", "after", "effect_on_next_decision"], "properties": {"state_id": {"$ref": "#/$defs/id"}, "before": {"$ref": "#/$defs/text"}, "after": {"$ref": "#/$defs/text"}, "effect_on_next_decision": {"$ref": "#/$defs/text"}}},
    "two_lap": {"type": "object", "additionalProperties": false, "required": ["lap_one", "feedback_state_deltas", "lap_two", "why_second_lap_is_not_repetition"], "properties": {"lap_one": {"$ref": "#/$defs/lap"}, "feedback_state_deltas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/delta"}}, "lap_two": {"$ref": "#/$defs/lap"}, "why_second_lap_is_not_repetition": {"$ref": "#/$defs/text"}}}
  }
}
